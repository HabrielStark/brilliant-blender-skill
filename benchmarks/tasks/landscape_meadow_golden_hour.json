    {"op": "apply_transform", "target": "horizon_sky_glow_band", "rotation": true, "scale": true},
    {"op": "create_mesh_primitive", "type": "ico_sphere", "name": "horizon_distant_hill_left", "size": 5.5, "location": [-4.5,6.2,0.2], "scale": [1.3,0.55,0.32], "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "ico_sphere", "name": "horizon_distant_hill_right", "size": 6.5, "location": [4.8,6.8,0.1], "scale": [1.2,0.5,0.26], "collection": "ENVIRONMENT"},
    {"op": "set_smooth_shading", "target": "horizon_distant_hill_left", "smooth": true},
    {"op": "set_smooth_shading", "target": "horizon_distant_hill_right", "smooth": true},

    {"op": "create_mesh_primitive", "type": "ico_sphere", "name": "mound_hero_grassy", "size": 3.1, "location": [0,0.4,0.42], "scale": [1.15,0.95,0.3], "collection": "SUBJECT"},
    {"op": "apply_transform", "target": "mound_hero_grassy", "scale": true},
    {"op": "set_smooth_shading", "target": "mound_hero_grassy", "smooth": true},
    {"op": "add_subdivision", "target": "mound_hero_grassy", "levels": 1},
    {"op": "create_procedural_texture", "name": "mound_relief_noise", "type": "CLOUDS", "noise_scale": 0.9, "noise_depth": 1, "contrast": 1.4},
    {"op": "add_modifier", "target": "mound_hero_grassy", "modifier": "DISPLACE", "params": {"texture": "mound_relief_noise", "strength": 0.09, "mid_level": 0.55}},
    {"op": "create_mesh_primitive", "type": "ico_sphere", "name": "boulder_granite_main", "size": 0.62, "location": [-0.85,-0.15,0.95], "rotation": [12,35,8], "scale": [1.0,0.82,0.78], "collection": "SUBJECT"},
    {"op": "apply_transform", "target": "boulder_granite_main", "rotation": true, "scale": true},
    {"op": "set_smooth_shading", "target": "boulder_granite_main", "smooth": true},
    {"op": "add_bevel_modifier", "target": "boulder_granite_main", "width": 0.04, "segments": 2},
    {"op": "create_mesh_primitive", "type": "ico_sphere", "name": "boulder_secondary_worn", "size": 0.34, "location": [1.15,0.85,0.68], "rotation": [40,10,70], "scale": [1.1,0.75,0.6], "collection": "SUBJECT"},
    {"op": "apply_transform", "target": "boulder_secondary_worn", "rotation": true, "scale": true},
    {"op": "set_smooth_shading", "target": "boulder_secondary_worn", "smooth": true},

    {"op": "create_geometry_nodes", "schema": {"node_group_name": "GN_Meadow_Rocks", "recipe": "GN_RockScatter", "target_object": "mound_hero_grassy", "inputs": {"rock_count": 14, "rock_size": 0.09, "seed": 7}, "export_policy": {"apply_before_glb": true, "max_generated_faces": 60000}}},
    {"op": "create_geometry_nodes", "schema": {"node_group_name": "GN_Meadow_Grass", "recipe": "GN_VegetationLow", "target_object": "meadow_ground_plane", "inputs": {"leaf_count": 60, "leaf_size": 0.16, "seed": 11}, "export_policy": {"apply_before_glb": true, "max_generated_faces": 60000}}},
    {"op": "create_geometry_nodes", "schema": {"node_group_name": "GN_Mound_Grass", "recipe": "GN_VegetationLow", "target_object": "mound_hero_grassy", "inputs": {"leaf_count": 40, "leaf_size": 0.14, "seed": 23}, "export_policy": {"apply_before_glb": true, "max_generated_faces": 60000}}},

    {"op": "create_mesh_primitive", "type": "cylinder", "name": "path_stone_step_01", "size": 0.42, "location": [0.55,-1.7,0.12], "scale": [1.15,0.9,0.14], "collection": "SUBJECT"},
    {"op": "create_mesh_primitive", "type": "cylinder", "name": "path_stone_step_02", "size": 0.38, "location": [0.35,-1.15,0.16], "rotation": [0,0,18], "scale": [1.1,0.85,0.13], "collection": "SUBJECT"},
