{
  "id": "landscape_meadow_golden_hour",
  "title": "Golden-hour meadow mound with boulder, grass and path",
  "prompt": "Create a golden-hour landscape still: a grassy mound with a granite boulder, scattered rocks and low vegetation, winding dirt path stones, and a warm low sun over a meadow.",
  "category": "landscape",
  "profile": "balanced",
  "manifest": {"task_id": "bench_meadow", "brief": "golden-hour meadow landscape hero",
    "output_mode": "still", "style": {"mood": "warm golden hour pastoral", "palette": ["olive green", "warm amber", "cool shadow"]},
    "target": {"final_format": ["blend", "png"], "web_runtime": "three"}},
  "checks": {
    "min_score": 84,
    "forbid_visual_style_tags": ["very_dark", "dark_blue_cyan"],
    "min_subject_objects": 20,
    "min_visible_subject_objects": 16,
    "min_visible_subject_coverage": 0.0001,
    "max_offscreen_subject_objects": 0,
    "min_subject_total_faces": 900,
    "min_subject_materials": 5,
    "min_subject_procedural_materials": 1,
    "min_subject_modifiers": 4,
    "min_smooth_subject_objects": 4,
    "min_craft_detail_objects": 8,
    "require_named_parts": ["mound", "boulder", "rock", "grass", "path", "stone", "leaf", "sun"],
    "require_readable_named_parts": true,
    "require_environment_named_parts": ["meadow", "ground", "horizon"]
  },
  "recipe": {"operations": [
    {"op": "ensure_standard_collections"},
    {"op": "create_mesh_primitive", "type": "plane", "name": "meadow_ground_plane", "size": 26, "collection": "ENVIRONMENT"},
