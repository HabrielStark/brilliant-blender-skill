{
  "id": "web_scroll_hero",
  "title": "Web scroll hero (R3F + GLB + camera path)",
  "prompt": "Floating aurora AI energy core for a website: teal glass core, warm ivory inner glow, gold orbital rings, magenta aurora ribbon trails, scroll camera effect, export GLB.",
  "category": "web",
  "profile": "balanced",
  "manifest": {"task_id": "bench_web_scroll_hero", "brief": "floating aurora kinetic AI core hero for a website with scroll camera",
    "output_mode": "interactive_web", "style": {"mood": "aurora kinetic sculpture", "palette": ["black", "teal", "magenta", "gold", "warm ivory"]},
    "target": {"final_format": ["blend", "png", "glb"], "web_runtime": "react-three-fiber"},
    "constraints": {"max_glb_mb": 20}},
  "checks": {"min_score": 84, "require_glb": true, "require_animation": true,
    "require_glb_animation": true, "min_animation_frames": 120,
    "min_keyframed_objects": 3, "min_sampled_moving_objects": 3,
    "min_sampled_rotation_radians": 3.0,
    "require_camera_animated": true, "min_camera_sampled_location_delta": 3.0,
    "require_animation_frame_proof": true,
    "min_animation_frame_delta": 0.006,
    "min_animation_changed_pixel_ratio": 0.012,
    "require_camera_path": true,
    "min_camera_path_samples": 9, "min_camera_path_distance": 3.0,
    "min_subject_objects": 34, "min_visible_subject_objects": 30,
    "min_visible_subject_coverage": 0.0001, "max_offscreen_subject_objects": 0,
    "min_subject_modifiers": 20, "min_smooth_subject_objects": 16,
    "min_subject_materials": 4,
    "min_subject_material_node_count": 5, "min_subject_procedural_materials": 2,
    "min_palette_similarity": 0.58,
    "require_named_parts": ["energy", "core", "orbital", "ring", "spark", "aurora"]},
  "recipe": {"operations": [
    {"op": "ensure_standard_collections"},
    {"op": "create_mesh_primitive", "type": "plane", "name": "stage_floor", "size": 20, "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "ico_sphere", "name": "energy_core", "size": 2, "location": [0,0,1.6], "collection": "SUBJECT"},
    {"op": "set_smooth_shading", "target": "energy_core", "smooth": true},
    {"op": "add_bevel_modifier", "target": "energy_core", "width": 0.015, "segments": 2},
    {"op": "create_mesh_primitive", "type": "torus", "name": "orbital_ring_primary", "size": 3.2, "location": [0,0,1.6], "collection": "SUBJECT"},
    {"op": "create_mesh_primitive", "type": "torus", "name": "orbital_ring_vertical", "size": 2.85, "location": [0,0,1.6], "rotation": [82,0,18], "collection": "SUBJECT"},
    {"op": "create_mesh_primitive", "type": "torus", "name": "orbital_ring_diagonal", "size": 3.55, "location": [0,0,1.6], "rotation": [54,28,-34], "collection": "SUBJECT"},
    {"op": "set_smooth_shading", "target": "orbital_ring_primary", "smooth": true},
    {"op": "set_smooth_shading", "target": "orbital_ring_vertical", "smooth": true},
    {"op": "set_smooth_shading", "target": "orbital_ring_diagonal", "smooth": true},
    {"op": "add_bevel_modifier", "target": "orbital_ring_primary", "width": 0.012, "segments": 2},
    {"op": "add_bevel_modifier", "target": "orbital_ring_vertical", "width": 0.01, "segments": 2},
    {"op": "add_bevel_modifier", "target": "orbital_ring_diagonal", "width": 0.01, "segments": 2},
    {"op": "create_mesh_primitive", "type": "uv_sphere", "name": "inner_white_core", "size": 0.82, "location": [0,0,1.6], "collection": "SUBJECT"},
    {"op": "set_smooth_shading", "target": "inner_white_core", "smooth": true},
    {"op": "create_material", "schema": {"name": "core_emissive_teal", "preset": "emissive_neon", "target_objects": ["energy_core"], "pbr": {"base_color": [0.02,0.32,0.3,1], "emission_color": [0.08,0.9,0.78,1], "emission_strength": 4.0}, "procedural": {"noise": true, "noise_scale": 28, "bump_strength": 0.02, "color_ramp": {"noise_scale": 18, "detail": 8, "colors": [[0.01,0.08,0.09,1], [0.1,0.9,0.78,1]]}}}},
    {"op": "create_material", "schema": {"name": "inner_warm_ivory_hot_core", "preset": "emissive_neon", "target_objects": ["inner_white_core"], "pbr": {"base_color": [1.0,0.92,0.66,1], "emission_color": [1.0,0.86,0.48,1], "emission_strength": 2.6}}},
    {"op": "create_material", "schema": {"name": "ring_gold_metal", "preset": "brushed_metal", "target_objects": ["orbital_ring_primary","orbital_ring_vertical","orbital_ring_diagonal"], "pbr": {"base_color": [0.78,0.52,0.2,1], "metallic": 1.0, "roughness": 0.35}, "procedural": {"wave": {"scale": 18, "distortion": 2, "bump_strength": 0.018}}}},
    {"op": "create_material", "schema": {"name": "spark_magenta_aurora", "preset": "emissive_neon", "pbr": {"base_color": [0.95,0.18,0.78,1], "emission_color": [0.95,0.18,0.78,1], "emission_strength": 2.2}}},
    {"op": "create_material", "schema": {"name": "stage_dark", "preset": "glossy_plastic", "target_objects": ["stage_floor"], "pbr": {"base_color": [0.038,0.03,0.07,1], "roughness": 0.24}}},
    {"op": "create_vfx", "schema": {"vfx_name": "core_glow", "preset": "energy_core_shell", "target": "energy_core", "profile": "balanced", "params": {"emission_strength": 5.0}}},
    {"op": "create_material", "schema": {"name": "core_emissive_teal", "preset": "emissive_neon", "target_objects": ["energy_core"], "pbr": {"base_color": [0.02,0.32,0.3,1], "emission_color": [0.08,0.9,0.78,1], "emission_strength": 4.0}, "procedural": {"noise": true, "noise_scale": 28, "bump_strength": 0.02, "color_ramp": {"noise_scale": 18, "detail": 8, "colors": [[0.01,0.08,0.09,1], [0.1,0.9,0.78,1]]}}}},
    {"op": "create_radial_markers", "name_prefix": "orbital_spark", "center": [0,0,1.6], "radius": 1.95, "count": 18, "size": [0.045,0.13,0.035], "collection": "SUBJECT", "material": "spark_magenta_aurora"},
    {"op": "create_radial_markers", "name_prefix": "inner_aurora_spark", "center": [0,0,1.6], "radius": 0.92, "count": 8, "size": [0.095,0.22,0.055], "collection": "SUBJECT", "material": "spark_magenta_aurora"},
    {"op": "create_energy_burst_streaks", "name_prefix": "aurora_trail_ribbon", "center": [0,0,1.6], "count": 12, "radius_min": 0.72, "radius_max": 1.55, "length_min": 0.44, "length_max": 1.25, "width": 0.045, "curl": 0.16, "fan_degrees": 320, "angle_degrees": 22, "tilt_degrees": 84, "segments": 14, "seed": 77, "collection": "SUBJECT", "material": "spark_magenta_aurora"},
    {"op": "create_lighting_rig", "schema": {"lighting_rig": "aurora_web_stage", "lights": [{"name": "teal_key", "type": "AREA", "power": 620, "size": 5.5, "color": [0.2,0.95,0.78], "position_role": "front_left_high"}, {"name": "magenta_fill", "type": "AREA", "power": 320, "size": 6.0, "color": [0.95,0.22,0.8], "position_role": "top"}], "world": {"color": [0.052,0.042,0.09], "strength": 0.62}}},
    {"op": "create_camera", "schema": {"camera_name": "camera_scroll_start", "preset": "scroll_hero_start", "target": "energy_core", "look_at": [0,0,1.6], "location": [0,-12,3.7], "lens": {"focal_length_mm": 30, "dof": true, "focus_target": "energy_core"}, "composition": {"subject_screen_coverage": 0.34, "safe_margin": 0.18}}},
    {"op": "create_animation", "schema": {"animation_name": "CoreIdle", "mode": "turntable", "frame_start": 1, "frame_end": 120, "fps": 24, "loop": true, "targets": ["orbital_ring_primary","orbital_ring_vertical","orbital_ring_diagonal","aurora_trail_ribbon_01","aurora_trail_ribbon_02","aurora_trail_ribbon_03"], "export": {"include_in_glb": true, "clip_name": "CoreIdle"}}},
    {"op": "create_animation", "schema": {"animation_name": "ScrollCameraMove", "mode": "scroll_linked", "frame_start": 1, "frame_end": 120, "fps": 24, "camera": {"name": "camera_scroll_start", "start_location": [0,-12,3.7], "end_location": [4,-9,3.35], "dof_target": "energy_core"}, "export": {"include_in_glb": true, "clip_name": "ScrollCameraMove"}}},
    {"op": "apply_post", "schema": {"post_preset": "aurora_web_readable", "view_transform": "AgX", "exposure": 0.45, "gamma": 1.0}},
    {"op": "set_scene_metadata", "data": {"final_camera": "camera_scroll_start"}}
  ]},
  "baseline_recipe": {"operations": [
    {"op": "create_mesh_primitive", "type": "uv_sphere", "name": "Sphere", "size": 2}
  ]},
  "adversarial_baselines": [
    {"id": "static_hero_no_scroll_path", "recipe": {"operations": [
      {"op": "ensure_standard_collections"},
      {"op": "create_mesh_primitive", "type": "uv_sphere", "name": "energy_core_orbital_ring_spark_aurora_static", "size": 2.0, "location": [0,0,1.6], "collection": "SUBJECT"},
      {"op": "create_mesh_primitive", "type": "torus", "name": "orbital_ring_static_gold", "size": 3.2, "location": [0,0,1.6], "collection": "SUBJECT"},
      {"op": "set_smooth_shading", "target": "energy_core_orbital_ring_spark_aurora_static", "smooth": true},
      {"op": "set_smooth_shading", "target": "orbital_ring_static_gold", "smooth": true},
      {"op": "create_material", "schema": {"name": "plain_teal_core", "preset": "emissive_neon", "target_objects": ["energy_core_orbital_ring_spark_aurora_static"], "pbr": {"base_color": [0.02,0.32,0.3,1], "emission_color": [0.08,0.9,0.78,1], "emission_strength": 2.0}}},
      {"op": "create_material", "schema": {"name": "plain_gold_ring", "preset": "brushed_metal", "target_objects": ["orbital_ring_static_gold"], "pbr": {"base_color": [0.78,0.52,0.2,1], "metallic": 1.0, "roughness": 0.35}}},
      {"op": "create_lighting_rig", "schema": {"lighting_rig": "flat_web_hero_light", "lights": [{"name": "teal_key", "type": "AREA", "power": 260, "size": 4, "color": [0.2,0.95,0.78], "position_role": "front_left_high"}], "world": {"color": [0.012,0.008,0.022], "strength": 0.25}}},
      {"op": "create_camera", "schema": {"camera_name": "camera_scroll_static", "target": "energy_core_orbital_ring_spark_aurora_static", "location": [0,-7,2.2], "lens": {"focal_length_mm": 45}}},
      {"op": "set_scene_metadata", "data": {"final_camera": "camera_scroll_static"}}
    ]}}
  ]
}
