      {"name": "door_back_glow", "type": "AREA", "power": 260, "size": 2.3, "color": [0.42,0.68,1.0], "location": [0,4.4,1.65]},
      {"name": "drone_eye_fill", "type": "POINT", "power": 65, "size": 1.2, "color": [0.16,0.54,1.0], "location": [0,-2.62,1.38]}
    ], "world": {"color": [0.004,0.006,0.012], "strength": 0.18}}},
