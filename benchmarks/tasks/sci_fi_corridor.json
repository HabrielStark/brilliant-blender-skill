    {"op": "create_geometry_nodes", "schema": {"node_group_name": "GN_RightWall_ProceduralPanels", "recipe": "GN_PanelWall", "target_object": "corridor_wall_right_depth", "inputs": {"panel_count": 28, "panel_depth": 0.055, "seed": 43}, "export_policy": {"apply_before_glb": true, "max_generated_faces": 160000}}},

    {"op": "create_material", "schema": {"name": "corridor_dark_brushed_panel", "preset": "painted_metal", "target_objects": ["corridor_wall_left_depth","corridor_wall_right_depth","corridor_ceiling_slab","distant_door_panel_center","distant_door_frame_left","distant_door_frame_right","distant_door_frame_top"], "pbr": {"base_color": [0.028,0.034,0.048,1], "metallic": 0.72, "roughness": 0.42}, "procedural": {"noise": true, "noise_scale": 44, "bump_strength": 0.018, "color_ramp": {"noise_scale": 24, "detail": 8, "colors": [[0.012,0.016,0.026,1], [0.07,0.085,0.12,1]]}}}},
    {"op": "create_material", "schema": {"name": "corridor_floor_wet_metal", "preset": "painted_metal", "target_objects": ["corridor_floor_long"], "pbr": {"base_color": [0.018,0.024,0.034,1], "metallic": 0.55, "roughness": 0.23}, "procedural": {"noise": true, "noise_scale": 34, "bump_strength": 0.012}}},
    {"op": "create_material", "schema": {"name": "rib_black_metal", "preset": "brushed_metal", "target_objects": [], "pbr": {"base_color": [0.012,0.014,0.02,1], "metallic": 0.9, "roughness": 0.34}}},
    {"op": "create_material", "schema": {"name": "rail_smoked_graphite", "preset": "painted_metal", "target_objects": [], "pbr": {"base_color": [0.045,0.052,0.064,1], "metallic": 0.75, "roughness": 0.31}}},
    {"op": "create_material", "schema": {"name": "light_cyan_emissive_strip", "preset": "emissive_neon", "target_objects": [], "pbr": {"base_color": [0.2,0.68,1.0,1], "emission_color": [0.12,0.52,1.0,1], "emission_strength": 1.45}}},
    {"op": "create_material", "schema": {"name": "light_white_door_emissive", "preset": "emissive_neon", "target_objects": [], "pbr": {"base_color": [0.82,0.94,1.0,1], "emission_color": [0.72,0.9,1.0,1], "emission_strength": 1.15}}},
    {"op": "create_material", "schema": {"name": "drone_black_brushed", "preset": "brushed_metal", "target_objects": [], "pbr": {"base_color": [0.01,0.014,0.02,1], "metallic": 1.0, "roughness": 0.24}, "procedural": {"noise": true, "noise_scale": 32, "bump_strength": 0.012, "color_ramp": {"noise_scale": 18, "detail": 7, "colors": [[0.004,0.006,0.012,1], [0.08,0.12,0.18,1]]}}}},
    {"op": "create_material", "schema": {"name": "drone_core_blue_emissive", "preset": "emissive_neon", "target_objects": [], "pbr": {"base_color": [0.06,0.28,0.8,1], "emission_color": [0.1,0.48,1.0,1], "emission_strength": 1.8}}},

    {"op": "create_linear_markers", "name_prefix": "corridor_rib_left_vertical", "start": [-2.02,-5.4,1.36], "step": [0,0.92,0], "count": 12, "size": [0.12,0.055,2.38], "material": "rib_black_metal", "collection": "ENVIRONMENT"},
    {"op": "create_linear_markers", "name_prefix": "corridor_rib_right_vertical", "start": [2.02,-5.4,1.36], "step": [0,0.92,0], "count": 12, "size": [0.12,0.055,2.38], "material": "rib_black_metal", "collection": "ENVIRONMENT"},
    {"op": "create_linear_markers", "name_prefix": "corridor_ceiling_cross_rib", "start": [0,-5.4,2.62], "step": [0,0.92,0], "count": 12, "size": [3.95,0.055,0.09], "material": "rib_black_metal", "collection": "ENVIRONMENT"},
    {"op": "create_linear_markers", "name_prefix": "corridor_floor_cross_rail", "start": [0,-5.4,0.04], "step": [0,0.92,0], "count": 12, "size": [3.5,0.05,0.035], "material": "rail_smoked_graphite", "collection": "ENVIRONMENT"},
    {"op": "create_linear_markers", "name_prefix": "corridor_left_light_strip", "start": [-1.86,-5.15,1.82], "step": [0,1.18,0], "count": 9, "size": [0.045,0.5,0.032], "material": "light_cyan_emissive_strip", "collection": "ENVIRONMENT"},
    {"op": "create_linear_markers", "name_prefix": "corridor_right_light_strip", "start": [1.86,-5.15,1.82], "step": [0,1.18,0], "count": 9, "size": [0.045,0.5,0.032], "material": "light_cyan_emissive_strip", "collection": "ENVIRONMENT"},
    {"op": "create_linear_markers", "name_prefix": "corridor_ceiling_light_panel", "start": [0,-5.2,2.66], "step": [0,1.25,0], "count": 8, "size": [0.42,0.6,0.024], "material": "light_white_door_emissive", "collection": "ENVIRONMENT"},
    {"op": "create_linear_markers", "name_prefix": "corridor_floor_guidance_light", "start": [-0.84,-5.15,0.07], "step": [0,1.18,0], "count": 9, "size": [0.055,0.45,0.022], "material": "light_cyan_emissive_strip", "collection": "ENVIRONMENT"},
    {"op": "create_linear_markers", "name_prefix": "corridor_floor_guidance_light_mirror", "start": [0.84,-5.15,0.07], "step": [0,1.18,0], "count": 9, "size": [0.055,0.45,0.022], "material": "light_cyan_emissive_strip", "collection": "ENVIRONMENT"},

