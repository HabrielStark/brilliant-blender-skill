{
  "id": "sci_fi_corridor",
  "title": "Sci-fi corridor (cinematic modular hall, geometry nodes)",
  "prompt": "Create a cinematic sci-fi corridor with real floor, ceiling, left/right wall depth, repeating modular ribs, procedural wall panels, emissive light strips, a distant door, and a deterministic Geometry Nodes seed.",
  "category": "geometry",
  "profile": "balanced",
  "manifest": {"task_id": "bench_sci_fi_corridor", "brief": "sci-fi corridor with depth, modular panels, practical emissive lighting, and procedural detail",
    "output_mode": "still", "style": {"mood": "cinematic sci-fi moody", "palette": ["black", "cold blue", "white highlights"]},
    "target": {"final_format": ["blend", "png"]}, "constraints": {}},
  "checks": {
    "min_score": 86,
    "max_subject_coverage": 0.9,
    "min_geometry_node_groups": 1,
    "require_geometry_seed": true,
    "min_geometry_node_count": 7,
    "min_geometry_link_count": 6,
    "min_geometry_detail_objects": 48,
    "require_geometry_detail_roles": ["panel_wall_plate"],
    "min_environment_objects": 32,
    "min_visible_environment_objects": 24,
    "min_visible_environment_coverage": 0.0001,
    "max_offscreen_environment_objects": 12,
    "min_environment_depth_layers": 8,
    "environment_depth_axis": "y",
    "environment_depth_tolerance": 0.45,
    "min_subject_objects": 5,
    "min_visible_subject_objects": 3,
    "min_visible_subject_coverage": 0.0001,
    "min_subject_materials": 3,
    "min_environment_materials": 5,
    "min_subject_material_node_count": 5,
    "min_subject_procedural_materials": 1,
    "min_subject_modifiers": 5,
    "min_emissive_materials": 3,
    "require_named_parts": ["drone", "core", "ring", "sensor", "antenna"],
    "require_environment_named_parts": ["corridor", "floor", "ceiling", "wall", "rib", "rail", "door", "light", "panel"]
  },
  "recipe": {"operations": [
    {"op": "ensure_standard_collections"},

    {"op": "create_mesh_primitive", "type": "plane", "name": "corridor_floor_long", "size": 1, "location": [0,-0.6,0], "scale": [2.65,7.2,1], "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "cube", "name": "corridor_wall_left_depth", "size": 1, "location": [-2.25,-0.55,1.35], "scale": [0.12,7.2,1.35], "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "cube", "name": "corridor_wall_right_depth", "size": 1, "location": [2.25,-0.55,1.35], "scale": [0.12,7.2,1.35], "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "cube", "name": "corridor_ceiling_slab", "size": 1, "location": [0,-0.55,2.78], "scale": [2.65,7.2,0.1], "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "cube", "name": "distant_door_panel_center", "size": 1, "location": [0,4.95,1.35], "scale": [1.08,0.08,1.05], "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "cube", "name": "distant_door_frame_left", "size": 1, "location": [-1.2,4.88,1.35], "scale": [0.09,0.12,1.25], "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "cube", "name": "distant_door_frame_right", "size": 1, "location": [1.2,4.88,1.35], "scale": [0.09,0.12,1.25], "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "cube", "name": "distant_door_frame_top", "size": 1, "location": [0,4.88,2.58], "scale": [1.28,0.12,0.08], "collection": "ENVIRONMENT"},

    {"op": "apply_transform", "target": "corridor_floor_long", "scale": true},
    {"op": "apply_transform", "target": "corridor_wall_left_depth", "scale": true},
    {"op": "apply_transform", "target": "corridor_wall_right_depth", "scale": true},
    {"op": "apply_transform", "target": "corridor_ceiling_slab", "scale": true},
