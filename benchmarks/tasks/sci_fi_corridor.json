    {"op": "assign_material", "target": "drone_antenna_top_fin", "material": "drone_black_brushed"},

    {"op": "create_lighting_rig", "schema": {"lighting_rig": "corridor_practical_lights", "lights": [
      {"name": "cyan_wall_wash_left", "type": "AREA", "power": 360, "size": 4.5, "color": [0.34,0.62,1.0], "location": [-1.5,-2.8,2.0]},
