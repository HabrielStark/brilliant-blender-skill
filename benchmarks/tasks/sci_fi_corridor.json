      {"op": "create_mesh_primitive", "type": "cube", "name": "corridor_floor_ceiling_wall_rib_rail_door_light_panel_box", "size": 3.0, "location": [0,0,1.2], "scale": [1.8,2.8,0.08], "collection": "ENVIRONMENT"},
      {"op": "create_mesh_primitive", "type": "uv_sphere", "name": "drone_core_ring_sensor_antenna_sphere", "size": 0.8, "location": [0,-1.0,1.4], "collection": "SUBJECT"},
      {"op": "apply_transform", "target": "corridor_floor_ceiling_wall_rib_rail_door_light_panel_box", "scale": true},
      {"op": "set_smooth_shading", "target": "drone_core_ring_sensor_antenna_sphere", "smooth": true},
      {"op": "create_material", "schema": {"name": "flat_corridor_dark", "preset": "painted_metal", "target_objects": ["corridor_floor_ceiling_wall_rib_rail_door_light_panel_box"], "pbr": {"base_color": [0.03,0.035,0.05,1], "metallic": 0.6, "roughness": 0.45}}},
      {"op": "create_material", "schema": {"name": "flat_drone_blue", "preset": "emissive_neon", "target_objects": ["drone_core_ring_sensor_antenna_sphere"], "pbr": {"base_color": [0.1,0.35,1.0,1], "emission_color": [0.1,0.35,1.0,1], "emission_strength": 1.0}}},
      {"op": "create_lighting_rig", "schema": {"lighting_rig": "flat_corridor_light", "lights": [{"name": "cold_key", "type": "AREA", "power": 300, "size": 5, "color": [0.62,0.76,1.0], "position_role": "front_left_high"}], "world": {"color": [0.006,0.008,0.014], "strength": 0.25}}},
      {"op": "create_camera", "schema": {"camera_name": "camera_corridor_keyword", "target": "drone_core_ring_sensor_antenna_sphere", "look_at": [0,-0.4,1.2], "location": [0,-5.0,1.6], "lens": {"focal_length_mm": 24}}},
