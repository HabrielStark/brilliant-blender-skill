{
  "id": "camera_expensive",
  "title": "Cinematography (make it look expensive, not default)",
  "prompt": "Make the object look expensive and cinematic, not like a default Blender object.",
  "category": "camera",
  "profile": "balanced",
  "manifest": {"task_id": "bench_camera_expensive", "brief": "expensive cinematic look for a single hero object",
    "output_mode": "still", "style": {"mood": "premium cinematic sharp high-contrast"},
    "target": {"final_format": ["blend", "png"]}, "constraints": {}},
  "checks": {"min_score": 86, "max_subject_coverage": 0.94,
    "min_subject_objects": 18, "min_visible_subject_objects": 20,
    "min_visible_subject_coverage": 0.0002, "max_offscreen_subject_objects": 1,
    "min_subject_total_faces": 1800,
    "min_subject_modifiers": 6, "min_smooth_subject_objects": 3,
    "min_subject_materials": 3,
    "min_subject_material_node_count": 5, "min_subject_procedural_materials": 2,
    "require_subject_material_features": ["noise_color_ramp"],
    "require_named_parts": ["plinth", "hero", "faceted", "facet", "accent", "ring", "highlight"]},
  "recipe": {"operations": [
    {"op": "ensure_standard_collections"},
    {"op": "create_mesh_primitive", "type": "plane", "name": "stage", "size": 18, "collection": "ENVIRONMENT"},
    {"op": "create_mesh_primitive", "type": "cylinder", "name": "low_black_plinth", "size": 2.6, "location": [0,0,0.62], "scale": [1,1,0.22], "collection": "SUBJECT"},
    {"op": "apply_transform", "target": "low_black_plinth", "scale": true},
    {"op": "set_smooth_shading", "target": "low_black_plinth", "smooth": true},
    {"op": "add_bevel_modifier", "target": "low_black_plinth", "width": 0.035, "segments": 3},
    {"op": "create_faceted_hero_body", "name": "hero_faceted_luxury_body", "radius": 0.9, "height": 1.82, "location": [0,0,1.48], "segments": 56, "rings": 22, "facet_twist_degrees": 18, "shoulder": 0.66, "waist": 0.22, "crown_height": 0.18, "pavilion_height": 0.22, "facet_depth": 0.07, "bevel_width": 0.014, "collection": "SUBJECT"},
    {"op": "create_mesh_primitive", "type": "torus", "name": "hero_blue_accent_ring", "size": 2.16, "location": [0,0,1.28], "scale": [1,1,0.14], "collection": "SUBJECT"},
    {"op": "set_smooth_shading", "target": "hero_blue_accent_ring", "smooth": true},
    {"op": "add_bevel_modifier", "target": "hero_blue_accent_ring", "width": 0.01, "segments": 2},
    {"op": "create_mesh_primitive", "type": "cylinder", "name": "faceted_top_highlight_cap", "size": 0.68, "location": [0,0,2.43], "scale": [1,1,0.055], "collection": "SUBJECT"},
    {"op": "apply_transform", "target": "faceted_top_highlight_cap", "scale": true},
    {"op": "set_smooth_shading", "target": "faceted_top_highlight_cap", "smooth": true},
    {"op": "add_bevel_modifier", "target": "faceted_top_highlight_cap", "width": 0.012, "segments": 2},
    {"op": "create_mesh_primitive", "type": "cube", "name": "vertical_sapphire_highlight_bar_left", "size": 1, "location": [-0.55,-0.72,1.48], "rotation": [12,0,16], "scale": [0.035,0.018,0.55], "collection": "SUBJECT"},
    {"op": "apply_transform", "target": "vertical_sapphire_highlight_bar_left", "scale": true},
    {"op": "add_bevel_modifier", "target": "vertical_sapphire_highlight_bar_left", "width": 0.008, "segments": 1},
    {"op": "create_mesh_primitive", "type": "cube", "name": "vertical_sapphire_highlight_bar_right", "size": 1, "location": [0.58,-0.66,1.42], "rotation": [10,0,-18], "scale": [0.03,0.018,0.48], "collection": "SUBJECT"},
    {"op": "apply_transform", "target": "vertical_sapphire_highlight_bar_right", "scale": true},
    {"op": "add_bevel_modifier", "target": "vertical_sapphire_highlight_bar_right", "width": 0.008, "segments": 1},
    {"op": "create_material", "schema": {"name": "plinth_obsidian", "preset": "glossy_plastic", "target_objects": ["low_black_plinth"], "pbr": {"base_color": [0.012,0.012,0.016,1], "roughness": 0.2}}},
    {"op": "create_material", "schema": {"name": "hero_titanium_faceted", "preset": "brushed_metal", "target_objects": ["hero_faceted_luxury_body","faceted_top_highlight_cap"], "pbr": {"base_color": [0.052,0.058,0.072,1], "metallic": 1.0, "roughness": 0.22}, "procedural": {"noise": true, "noise_scale": 120, "bump_strength": 0.025, "color_ramp": {"noise_scale": 34, "detail": 10, "colors": [[0.014,0.015,0.02,1], [0.26,0.30,0.40,1]]}}}},
    {"op": "create_material", "schema": {"name": "thin_blue_edge_light", "preset": "emissive_neon", "target_objects": ["hero_blue_accent_ring"], "pbr": {"base_color": [0.25,0.45,1.0,1], "emission_color": [0.25,0.45,1.0,1], "emission_strength": 1.8}}},
    {"op": "create_linear_markers", "name_prefix": "front_facet_highlight_tick", "start": [-0.72,-0.93,1.08], "step": [0.16,0,0.045], "count": 10, "size": [0.06,0.028,0.045], "rotation": [0,0,0], "collection": "SUBJECT", "material": "thin_blue_edge_light"},
    {"op": "create_material", "schema": {"name": "sapphire_highlight_glass", "preset": "glass_clear", "target_objects": ["vertical_sapphire_highlight_bar_left","vertical_sapphire_highlight_bar_right"], "pbr": {"base_color": [0.22,0.42,0.95,1], "roughness": 0.05, "transmission": 0.8}, "procedural": {"noise": true, "noise_scale": 52, "bump_strength": 0.01}}},
    {"op": "create_radial_markers", "name_prefix": "facet_catchlight_marker", "center": [0,0,1.55], "radius": 0.98, "count": 12, "size": [0.035,0.16,0.018], "collection": "SUBJECT", "material": "thin_blue_edge_light"},
    {"op": "create_material", "schema": {"name": "stage_dark", "preset": "glossy_plastic", "target_objects": ["stage"], "pbr": {"base_color": [0.006,0.006,0.009,1], "roughness": 0.16}}},
    {"op": "create_lighting_rig", "schema": {"lighting_rig": "dramatic_rim", "lights": [{"name": "key_soft", "type": "AREA", "power": 980, "size": 5.4, "position_role": "front_left_high"}, {"name": "rim_cool", "type": "AREA", "power": 430, "size": 2, "color": [0.4,0.55,1.0], "position_role": "rim"}, {"name": "fill", "type": "AREA", "power": 260, "size": 5, "position_role": "top"}, {"name": "warm_front_glint", "type": "POINT", "power": 85, "size": 0.75, "color": [1.0,0.76,0.48], "location": [-1.55,-2.35,1.92]}], "world": {"color": [0.018,0.02,0.028], "strength": 0.48}}},
    {"op": "create_camera", "schema": {"camera_name": "camera_cinematic_hero", "preset": "hero_low_angle", "target": "hero_faceted_luxury_body", "location": [5.4,-7.4,2.85], "lens": {"focal_length_mm": 62, "dof": true, "focus_target": "hero_faceted_luxury_body", "aperture_fstop": 2.4}, "composition": {"subject_screen_coverage": 0.58, "safe_margin": 0.1, "leading_lines": true}}},
    {"op": "set_scene_metadata", "data": {"final_camera": "camera_cinematic_hero"}}
  ]},
  "baseline_recipe": {"operations": [
    {"op": "create_mesh_primitive", "type": "ico_sphere", "name": "Icosphere", "size": 2}
  ]},
  "adversarial_baselines": [
    {
      "id": "named_lit_sphere",
      "recipe": {"operations": [
        {"op": "ensure_standard_collections"},
        {"op": "create_mesh_primitive", "type": "plane", "name": "stage", "size": 18, "collection": "ENVIRONMENT"},
        {"op": "create_mesh_primitive", "type": "cylinder", "name": "low_black_plinth", "size": 2.6, "location": [0,0,0.62], "scale": [1,1,0.22], "collection": "SUBJECT"},
        {"op": "apply_transform", "target": "low_black_plinth", "scale": true},
        {"op": "set_smooth_shading", "target": "low_black_plinth", "smooth": true},
        {"op": "add_bevel_modifier", "target": "low_black_plinth", "width": 0.035, "segments": 3},
        {"op": "create_mesh_primitive", "type": "ico_sphere", "name": "hero_faceted_accent_ring_highlight_keyword_sphere", "size": 2, "location": [0,0,1.3], "collection": "SUBJECT"},
        {"op": "set_smooth_shading", "target": "hero_faceted_accent_ring_highlight_keyword_sphere", "smooth": true},
        {"op": "add_bevel_modifier", "target": "hero_faceted_accent_ring_highlight_keyword_sphere", "width": 0.02, "segments": 3},
        {"op": "create_material", "schema": {"name": "hero_titanium_faceted", "preset": "brushed_metal", "target_objects": ["hero_faceted_accent_ring_highlight_keyword_sphere"], "pbr": {"base_color": [0.034,0.038,0.048,1], "metallic": 1.0, "roughness": 0.24}}},
        {"op": "create_material", "schema": {"name": "stage_dark", "preset": "glossy_plastic", "target_objects": ["stage"], "pbr": {"base_color": [0.006,0.006,0.009,1], "roughness": 0.16}}},
        {"op": "create_lighting_rig", "schema": {"lighting_rig": "adversarial_lit_sphere", "lights": [{"name": "key_soft", "type": "AREA", "power": 600, "size": 6, "position_role": "front_left_high"}, {"name": "rim_cool", "type": "AREA", "power": 300, "size": 2, "color": [0.4,0.55,1.0], "position_role": "rim"}], "world": {"color": [0.008,0.01,0.015], "strength": 0.3}}},
        {"op": "create_camera", "schema": {"camera_name": "camera_adversarial_sphere", "preset": "hero_low_angle", "target": "hero_faceted_accent_ring_highlight_keyword_sphere", "location": [5.2,-7.0,2.5], "lens": {"focal_length_mm": 62, "dof": true, "focus_target": "hero_faceted_accent_ring_highlight_keyword_sphere", "aperture_fstop": 2.2}}},
        {"op": "set_scene_metadata", "data": {"final_camera": "camera_adversarial_sphere"}}
      ]}
    }
  ]
}
