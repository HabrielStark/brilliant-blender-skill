# Optional runtime configuration for local MCP / Blender runs.
# Copy to .env only if your host tool loads .env files; do not put secrets here.

# Absolute Blender executable path. Leave empty to auto-detect from PATH or
# standard install folders.
BLENDER_EXECUTABLE=

# Workspace sandbox root for generated scenes, logs, renders, and exports.
BCAS_WORKSPACE_ROOT=./artifacts

# strict = structured operations only. dev enables explicit development-only
# paths such as raw Python checks when BCAS_RAW_PYTHON=1.
BCAS_SAFETY_MODE=strict
BCAS_ALLOW_NETWORK=0
BCAS_RAW_PYTHON=0

# Localhost bridge defaults for the Blender add-on.
BCAS_BRIDGE_HOST=127.0.0.1
BCAS_BRIDGE_PORT=8765
